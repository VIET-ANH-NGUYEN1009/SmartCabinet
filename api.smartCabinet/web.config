<configuration>
    <system.webServer>

        <!-- THÊM: gỡ WebDAV vì module này chặn PUT/DELETE trước khi tới Node (lỗi 405) -->
        <modules>
            <remove name="WebDAVModule" />
        </modules>

        <!-- indicates that the server.js file is a node.js application
        to be handled by the iisnode module -->

        <handlers>
            <remove name="WebDAV" />  <!-- THÊM -->
            <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
        </handlers>

        <rewrite>
            <rules>
                <rule name="api.smartcabinet">
                    <match url="/*" />
                    <action type="Rewrite" url="server.js" />
                </rule>
            </rules>
        </rewrite>

        <!-- THÊM: không cho tải file .env (chứa mật khẩu DB) hay node_modules qua web -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment="node_modules" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <iisnode node_env="production" nodeProcessCommandLine="&quot;D:\nvm-noinstall\v22.17.1\node.exe&quot;" interceptor="&quot;%programfiles%\iisnode\interceptor.js&quot;" watchedFiles="*.js;*.mjs;*.json;*.ts;node_modules\*;web.config;.next\*;.env" />
    </system.webServer>
</configuration>
